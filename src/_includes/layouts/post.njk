---
layout: base.njk
---

<article>

  <h1 class="post-title">{{ title }}</h1>

  <div class="post-meta">
    {{ pubDate | date("yyyy.MM.dd") }} · {{ site.author }}
    {% if mood %}
    <span class="mood">― {{ mood }}</span>
    {% endif %}
  </div>

  {% if music %}
  {% include "components/music.njk" %}
  {% endif %}

  <div class="post-content">
    {{ content | safe }}
  </div>

  <hr>

  {% if tags %}
  <div class="post-tags">
    <span class="label">Label</span>
    <span class="sep">│</span>
    {% for tag in tags %}
    {% if tag != "post" %}
    <a href="/tags/{{ tag }}/" class="tag-box">{{ tag }}</a>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <div class="post-nav">
    {% if previousPost %}
    <a href="{{ previousPost.url }}" class="prev">{{ previousPost.data.title }}</a>
    {% else %}
    <span></span>
    {% endif %}

    {% if nextPost %}
    <a href="{{ nextPost.url }}" class="next">{{ nextPost.data.title }}</a>
    {% endif %}
  </div>

  <div>
    <a href="/archive/" class="to-archive">→ archive</a>
  </div>

</article>