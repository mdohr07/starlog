--- 
layout: base.njk 
---

<article>

  <div class="post-meta">
    &gt; LOG ENTRY //
    {{ pubDate | date("yyyy.MM.dd") }}
    //
    {% for tag in tags %}{% endfor %}
    {% if mood %}
      <span class="tag">MOOD:
        {{ mood }}</span>
    {% endif %}
  </div>

  <h1 class="post-title">{{ title }}</h1>

  <p class="post-sub">{{ site.author }}
    &nbsp;·&nbsp;
    {{ content | wordcount }}
    Wörter</p>

  {% if music %}
    {% include "components/music.njk" %}
  {% endif %}

  <div class="post-content">
    {{ content | safe }}
  </div>

  <div class="cursor-line">_
    <span class="blink">▌</span></div>

    <hr>

  {% if tags %}
    <div class="post-tags">
      <span class="label">TAGS</span>
      <span class="sep">│</span>
      {% for tag in tags %}
        {% if tag != "post" %}
          <a href="/tags/{{ tag }}/" class="tag-box">{{ tag }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <div class="post-nav">
    {% if previousPost %}
      <a href="{{ previousPost.url }}" class="prev">{{ previousPost.data.title }}</a>
    {% else %}
      <span></span>
    {% endif %}

    {% if nextPost %}
      <a href="{{ nextPost.url }}" class="next">{{ nextPost.data.title }}</a>
    {% endif %}
  </div>

  <div>
    <span class="to-archive">-----</span><br>
    <a href="/archive/" class="to-archive">// archive</a>
  </div>

</article>